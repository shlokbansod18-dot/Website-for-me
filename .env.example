# ─────────────────────────────────────────────────────────────
#  SoftSystem — environment template
#  Copy this file to `.env`, then run `npm run setup` to have
#  the secrets below generated for you automatically.
# ─────────────────────────────────────────────────────────────

# Public origin of the site. Used for absolute links, invoices,
# and for rejecting cross-origin form posts (CSRF defence).
APP_URL="http://localhost:3000"

# Signs and verifies session cookies. 64 hex characters.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Encrypts personal data at rest (billing name, address, tax id).
# 64 hex characters. Changing this makes existing encrypted rows unreadable.
ENCRYPTION_KEY=""

# Where the SQLite database and uploaded product files live.
DATA_DIR="./data"

# The email address that gets seller/admin access to the Studio.
# The first account registered with this address becomes the owner, so sign up
# with it once the site is live and your Studio is waiting.
OWNER_EMAIL="hello.softsystem@gmail.com"
